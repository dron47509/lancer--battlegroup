var _maneuvers_built := false
var _tactics_built := false

func _ready() -> void:
	_phase_select.clear()
	for i in range(PHASE_NAMES.size()):
		_phase_select.add_item(PHASE_NAMES[i], i)
	if not _phase_select.item_selected.is_connected(_on_phase_selected):
		_phase_select.item_selected.connect(_on_phase_selected)
	if not BattlegroupData.battle_state_changed.is_connected(_on_battle_state_changed):
		BattlegroupData.battle_state_changed.connect(_on_battle_state_changed)
	_phase_select.select(0)
	_apply_phase_text(0)
	_apply_battle_state()

func _on_phase_selected(index: int) -> void:
	_apply_phase_text(index)

func _apply_phase_text(index: int) -> void:
	if index < 0 or index >= PHASE_TEXTS.size():
		_phase_text.text = ""
		_update_maneuver_visibility(-1)
		return
	_phase_text.text = PHASE_TEXTS[index]
	_update_maneuver_visibility(index)

func _update_maneuver_visibility(index: int) -> void:
	var show := index == ACTION_PHASE_INDEX
	if is_instance_valid(_maneuver_separator):
		_maneuver_separator.visible = show
	if is_instance_valid(_action_label):
		_action_label.visible = show
	if is_instance_valid(_maneuver_container):
		_maneuver_container.visible = show
	if is_instance_valid(_tactic_container):
		_tactic_container.visible = show
	if show:
		_build_action_maneuvers()
		_build_action_tactics()

func _on_battle_state_changed(_enabled: bool) -> void:
	_apply_battle_state()

func _apply_battle_state() -> void:
	visible = BattlegroupData.in_battle

func _build_action_maneuvers() -> void:
	if _maneuvers_built:
		return
	if not is_instance_valid(_maneuver_container):
		return
	for entry in ACTION_MANEUVERS:
		var card: Control = ITEM_CARD_SCENE.instantiate()
		_maneuver_container.add_child(card)
		var payload = entry.duplicate(true)
		if card.has_method("setup"):
			card.call_deferred("setup", payload, false, {}, false, "option", true)
		elif card.has_method("populate"):
			card.call_deferred("populate", payload)
			if card.has_method("set_context"):
				card.call_deferred("set_context", false, {}, false, "option")
			if card.has_method("set_collapsed"):
				card.call_deferred("set_collapsed", true)
	_maneuvers_built = true

func _build_action_tactics() -> void:
	if _tactics_built:
		return
	if not is_instance_valid(_tactic_container):
		return
	for entry in ACTION_TACTICS:
		var card: Control = ITEM_CARD_SCENE.instantiate()
		_tactic_container.add_child(card)
		var payload = entry.duplicate(true)
		if card.has_method("setup"):
			card.call_deferred("setup", payload, false, {}, false, "option", true)
		elif card.has_method("populate"):
			card.call_deferred("populate", payload)
			if card.has_method("set_context"):
				card.call_deferred("set_context", false, {}, false, "option")
			if card.has_method("set_collapsed"):
				card.call_deferred("set_collapsed", true)
	_tactics_built = true
